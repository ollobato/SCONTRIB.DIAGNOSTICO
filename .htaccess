# Desativa cache de arquivos HTML para garantir que alterações apareçam imediatamente
<IfModule mod_headers.c>
    <FilesMatch "\.(html|htm|php)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redireciona subdomínio diagnostico para a pasta /diagnostico caso o subdomínio aponte para a raiz
    RewriteCond %{HTTP_HOST} ^diagnostico\.supercontribuidor\.com\.br$ [NC]
    RewriteCond %{REQUEST_URI} !^/diagnostico/
    RewriteRule ^(.*)$ /diagnostico/$1 [L]

    # Rotas amigáveis para o curso De Inteligente a Indispensável
    RewriteRule ^cursos/deinteligenteaindispens[aá]vel/?$ /cursos/deinteligenteaindispensavel/index.html [L,NC]
    RewriteRule ^cursos/deinteligenteaindispens[aá]vel/obrigado/?$ /cursos/deinteligenteaindispensavel/obrigado/index.html [L,NC]
    RewriteRule ^cursos/de-inteligente-a-indispensavel/?$ /cursos/deinteligenteaindispensavel/index.html [L,NC]
    RewriteRule ^cursos/de-inteligente-a-indispensavel/obrigado/?$ /cursos/deinteligenteaindispensavel/obrigado/index.html [L,NC]

    # Força HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>
